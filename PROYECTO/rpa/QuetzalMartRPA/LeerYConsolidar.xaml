ias.xlsx")</mca:CSharpValue></InArgument></uea:WriteRange.WorkbookPath><uea:WriteRange.SheetName><InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">"existencias"</mca:CSharpValue></InArgument></uea:WriteRange.SheetName><uea:WriteRange.DataTable><InArgument x:TypeArguments="sd:DataTable"><mca:CSharpValue x:TypeArguments="sd:DataTable">dtExistencias</mca:CSharpValue></InArgument></uea:WriteRange.DataTable></uea:WriteRange></Sequence><Sequence DisplayName="Escribir rechazos.xlsx" sap2010:WorkflowViewState.IdRef="Sequence_9"><If DisplayName="¿Existe rechazos.xlsx?" sap2010:WorkflowViewState.IdRef="If_8"><If.Condition><InArgument x:TypeArguments="x:Boolean"><mca:CSharpValue x:TypeArguments="x:Boolean">System.IO.File.Exists(System.IO.Path.Combine(in_CarpetaSalida, "rechazos.xlsx"))</mca:CSharpValue></InArgument></If.Condition><If.Then><ui:DeleteFileX DisplayName="Delete File (rechazos.xlsx anterior)" sap2010:WorkflowViewState.IdRef="DeleteFileX_4"><ui:DeleteFileX.Path><InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">System.IO.Path.Combine(in_CarpetaSalida, "rechazos.xlsx")</mca:CSharpValue></InArgument></ui:DeleteFileX.Path></ui:DeleteFileX></If.Then></If><uea:WriteRange DisplayName="Write Range Workbook (rechazos)" AddHeaders="True" sap2010:WorkflowViewState.IdRef="WriteRange_4"><uea:WriteRange.WorkbookPath><InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">System.IO.Path.Combine(in_CarpetaSalida, "rechazos.xlsx")</mca:CSharpValue></InArgument></uea:WriteRange.WorkbookPath><uea:WriteRange.SheetName><InArgument x:TypeArguments="x:String"><mca:CSharpValue x:TypeArguments="x:String">"rechazos"</mca:CSharpValue></InArgument></uea:WriteRange.SheetName><uea:WriteRange.DataTable><InArgument x:TypeArguments="sd:DataTable"><mca:CSharpValue x:TypeArguments="sd:DataTable">dtRechazos</mca:CSharpValue></InArgument></uea:WriteRange.DataTable></uea:WriteRange></Sequence><Assign DisplayName