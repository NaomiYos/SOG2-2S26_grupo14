ents="x:String, Argument"><InOutArgument x:TypeArguments="sd:DataTable" x:Key="dtHoja"><mca:CSharpReference x:TypeArguments="sd:DataTable">dtHoja</mca:CSharpReference></InOutArgument><InArgument x:TypeArguments="x:String" x:Key="archivo"><mca:CSharpValue x:TypeArguments="x:String">archivo</mca:CSharpValue></InArgument><InArgument x:TypeArguments="x:String" x:Key="hoja"><mca:CSharpValue x:TypeArguments="x:String">CurrentSheet.Name</mca:CSharpValue></InArgument></scg:Dictionary></ui:InvokeCode.Arguments></ui:InvokeCode><If DisplayName="¿Hoja clientes o productos?" sap2010:WorkflowViewState.IdRef="If_3"><If.Condition><InArgument x:TypeArguments="x:Boolean"><mca:CSharpValue x:TypeArguments="x:Boolean">CurrentSheet.Name == "clientes"</mca:CSharpValue></InArgument></If.Condition><If.Then><If DisplayName="¿Primera hoja clientes?" sap2010:WorkflowViewState.IdRef="If_1"><If.Condition><InArgument x:TypeArguments="x:Boolean"><mca:CSharpValue x:TypeArguments="x:Boolean">dtClientesCrudo == null</mca:CSharpValue></InArgument></If.Condition><If.Then><Assign DisplayName="Primera hoja clientes" sap2010:WorkflowViewState.IdRef="Assign_1"><Assign.To><OutArgument x:TypeArguments="sd:DataTable"><mca:CSharpReference x:TypeArguments="sd:DataTable">dtClientesCrudo</mca:CSharpReference></OutArgument></Assign.To><Assign.Value><InArgument x:TypeArguments="sd:DataTable"><mca:CSharpValue x:TypeArguments="sd:DataTable">dtHoja</mca:CSharpValue></InArgument></Assign.Value></Assign></If.Then><If.Else><ui:MergeDataTable DisplayName="Merge Data Table (clientes)" MissingSchemaAction="Add" sap2010:WorkflowViewState.IdRef="MergeDataTable_1"><ui:MergeDataTable.Source><InArgument x:TypeArguments="sd:DataTable"><mca:CSharpValue x:TypeArguments="sd:DataTable">dtHoja</mca:CSharpValue></InArgument></ui:MergeDataTable.Source><ui:MergeDataTable.Destination><InOutArgument x:TypeArguments="sd:DataTable"><mca:CSharpReference x:TypeArguments="sd:DataTable">dtClientesCrudo</mca:CSharpReference></InOutArgument></ui:M