; Copiar como odoo.conf (no se sube) y cambiar admin_passwd.
[options]
; Módulos OCA: se descargan con infra/obtener_addons.sh. Al agregar repos OCA o módulos qm_,
; añadir aquí su ruta dentro de /mnt/extra-addons
addons_path = /mnt/extra-addons,/mnt/extra-addons/oca/dms
data_dir = /var/lib/odoo
admin_passwd = cambiar_esta_clave_maestra
db_name = quetzalmart
dbfilter = ^quetzalmart$
list_db = False
proxy_mode = True
; En el servidor: 2 (websocket por el puerto 8072 vía Caddy). En local: 0, porque no hay proxy.
workers = 2
max_cron_threads = 1
gevent_port = 8072
limit_time_cpu = 600
limit_time_real = 1200
limit_memory_soft = 1073741824
limit_memory_hard = 1342177280
